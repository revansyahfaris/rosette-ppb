{
  "info": {
    "name": "Rosette API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "snapshotId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Catatan Kuliah\",\n  \"description\": \"Rangkuman materi semester ganjil\"\n}"
            }
          }
        },
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{bookId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Catatan Kuliah 2026\"\n}"
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books",
                "{{bookId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Create Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": \"{{bookId}}\",\n  \"title\": \"Bab 1 - Pendahuluan\",\n  \"content\": \"<p>Halo, ini draft pertama.</p>\"\n}"
            }
          }
        },
        {
          "name": "Get All Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents"
              ]
            }
          }
        },
        {
          "name": "Get Documents by Book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents?book_id={{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents"
              ],
              "query": [
                {
                  "key": "book_id",
                  "value": "{{bookId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Document by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "{{documentId}}"
              ]
            }
          }
        },
        {
          "name": "Update Document Content",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "{{documentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"<p>Halo, ini draft kedua yang sudah direvisi.</p>\"\n}"
            }
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "{{documentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Snapshots",
      "item": [
        {
          "name": "Create Snapshot (Commit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/snapshots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "snapshots"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_id\": \"{{documentId}}\",\n  \"message\": \"Draft pertama selesai\"\n}"
            }
          }
        },
        {
          "name": "Get All Snapshots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/snapshots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "snapshots"
              ]
            }
          }
        },
        {
          "name": "Get Snapshots by Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/snapshots?document_id={{documentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "snapshots"
              ],
              "query": [
                {
                  "key": "document_id",
                  "value": "{{documentId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Snapshot by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/snapshots/{{snapshotId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "snapshots",
                "{{snapshotId}}"
              ]
            }
          }
        },
        {
          "name": "Restore Snapshot",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/snapshots/{{snapshotId}}/restore",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "snapshots",
                "{{snapshotId}}",
                "restore"
              ]
            }
          }
        },
        {
          "name": "Delete Snapshot",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/snapshots/{{snapshotId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "snapshots",
                "{{snapshotId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}